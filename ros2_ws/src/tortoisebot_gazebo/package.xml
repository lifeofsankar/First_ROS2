<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tortoisebot_gazebo</name>
  <version>0.0.0</version>
  <description>Simulating TortoiseBot in Gazebo with ROS 2</description>
  <maintainer email="yashikasharma@asimovtrainees.com">Yashika Sharma</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
<depend>std_msgs</depend>
<depend>sensor_msgs</depend>
<depend>geometry_msgs</depend>

  <!-- Build and exec depends -->
  <exec_depend>xacro</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Gazebo & ROS-GZ bridge -->
  <exec_depend>ros_gz</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>


<exec_depend>ros_gz_sim</exec_depend>

<depend>ros_gz_image</depend>

  <depend>tf2</depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
