<?xml version="1.0" ?>
<robot name="turtlebot3_waffle" xmlns:gz="http://gazebosim.org/sdf">

  <!-- Colors: JCB Industrial Style -->
<material name="sensor_blue">
  <color rgba="0.05 0.10 0.35 1.0"/>
</material>

<material name="jcb_yellow">
  <color rgba="0.98 0.78 0.02 1.0"/>
</material>

<material name="jcb_orange">
  <color rgba="1.0 0.50 0.0 1.0"/>
</material>

<material name="matte_black">
  <color rgba="0.05 0.05 0.05 1.0"/>
</material>

<material name="glossy_red">
  <color rgba="0.85 0.05 0.05 1.0"/>
</material>


<!-- #Links# -->

  <!-- Base footprint -->
  <link name="base_footprint"/>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="/home/admin/First_ROS2/turtlebot3_ws/src/tortoisebot_description/meshes/bases/waffle_base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="jcb_orange"/>
    </visual>

    <collision>
      <origin xyz="-0.064 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="/home/admin/First_ROS2/turtlebot3_ws/src/tortoisebot_description/meshes/bases/waffle_base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.3729096"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0087" ixy="0.0" ixz="0.0"
               iyy="0.0086" iyz="0.0"
               izz="0.0146"/>
    </inertial>
  </link>

  <!-- Left wheel -->
  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="/home/admin/First_ROS2/turtlebot3_ws/src/tortoisebot_description/meshes/wheels/left_tire.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
        <material name="glossy_red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="/home/admin/First_ROS2/turtlebot3_ws/src/tortoisebot_description/meshes/wheels/left_tire.stl"
              scale="0.001 0.001 0.001"/>
        </geometry>  
    </collision>

    <inertial>
      <mass value="0.0285"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.11e-05" ixy="0" ixz="0"
               iyy="1.11e-05" iyz="0"
               izz="2.07e-05"/>
    </inertial>
  </link>

  <!-- Right wheel -->
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="/home/admin/First_ROS2/turtlebot3_ws/src/tortoisebot_description/meshes/wheels/right_tire.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
       <material name="glossy_red"/>
    </visual>

    <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="/home/admin/First_ROS2/turtlebot3_ws/src/tortoisebot_description/meshes/wheels/right_tire.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.0285"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.11e-05" ixy="0" ixz="0"
               iyy="1.11e-05" iyz="0"
               izz="2.07e-05"/>
    </inertial>
  </link>

   <!-- Rear casters -->
  <link name="caster_back_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Ball caster -->
        <sphere radius="0.006"/>
      </geometry>
      <material name="matte_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.006"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- inertia for sphere: I = 2/5 * m * r^2 -->
      <inertia 
        ixx="0.00001" ixy="0" ixz="0"
        iyy="0.00001" iyz="0"
        izz="0.00001"/>
    </inertial>
  </link>

   <link name="caster_back_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="matte_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia 
        ixx="0.00001" ixy="0" ixz="0"
        iyy="0.00001" iyz="0"
        izz="0.00001"/>
    </inertial>
  </link>
  
  <!-- IMU -->
  <!-- <link name="imu_link"/> -->

  <link name="base_scan">
    <visual>
      <geometry>
        <mesh filename="/home/admin/First_ROS2/turtlebot3_ws/src/tortoisebot_description/meshes/sensors/lds.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="jcb_yellow"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="/home/admin/First_ROS2/turtlebot3_ws/src/tortoisebot_description/meshes/sensors/lds.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.114"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
              iyy="0.001" iyz="0"
              izz="0.001"/>
    </inertial>
  </link>

  <!-- Camera -->
  <!-- <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 1.57"/>
      <geometry>
        <mesh filename="package://tortoisebot_description/meshes/sensors/r200.dae"/>
      </geometry>
      <material name="jcb_yellow"/>
    </visual>
  </link> -->


<!-- #Joints# -->

  <!-- Base footprint -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link" />
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>
  
  <!-- Wheel Joints -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.144 0.023" rpy="0 0 0"/>  <!-- Changed back to 0.023 -->
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.144 0.023" rpy="0 0 0"/>  <!-- Changed back to 0.023 -->
    <axis xyz="0 1 0"/>
  </joint>

<!-- Caster Joint -->
  <joint name="caster_back_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_back_right_link"/>
    <origin xyz="-0.177 -0.064 -0.007" rpy="0 0 0"/>  <!-- 0.012 - 0.010 = 0.002 -->
    <!-- <axis xyz="0 0 1"/> -->
  </joint>

  <joint name="caster_back_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_back_left_link"/>
    <origin xyz="-0.177 0.064 -0.007" rpy="0 0 0"/>  <!-- 0.012 - 0.010 = 0.002 -->
    <!-- <axis xyz="0 0 1"/> -->
  </joint>
 
  <!-- IMU -->
  <!-- <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0 0.068"/>
  </joint> -->

  <!-- LIDAR -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.064 0 0.122" rpy="0 0 0"/>
  </joint>

  <!-- Camera -->
 <!-- <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.064 -0.065 0.094"/>
  </joint> -->


  <!-- #Gazebo# -->

  <!-- Gazebo physics for right caster -->
  <gazebo reference="caster_back_right_link">
    <material>
      <diffuse>0.05 0.05 0.05 1.0</diffuse>
      <ambient>0.05 0.05 0.05 1.0</ambient>
    </material>
    <mu1>0.0</mu1>  <!-- Very low friction for rolling -->
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>  <!-- Contact stiffness -->
    <kd>100.0</kd>      <!-- Contact damping -->
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- Gazebo physics for left caster -->
  <gazebo reference="caster_back_left_link">
    <material>
      <diffuse>0.05 0.05 0.05 1.0</diffuse>
      <ambient>0.05 0.05 0.05 1.0</ambient>
    </material>
    <mu1>0.0</mu1>  <!-- Very low friction for rolling -->
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>  <!-- Contact stiffness -->
    <kd>100.0</kd>      <!-- Contact damping -->
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo reference="base_scan">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <gz:frame_id>base_scan</gz:frame_id>

      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.1</min>  
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="base_link">
    <material>
      <diffuse>1.0 0.50 0.0 1.0</diffuse>
      <ambient>1.0 0.50 0.0 1.0</ambient>
    </material>
  </gazebo>

  <gazebo reference="wheel_left_link">
    <material>
      <diffuse>0.85 0.05 0.05 1.0</diffuse>
      <ambient>0.85 0.05 0.05 1.0</ambient>
    </material>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <material>
      <diffuse>0.85 0.05 0.05 1.0</diffuse>
      <ambient>0.85 0.05 0.05 1.0</ambient>
    </material>
  </gazebo>

  <!-- Joint State Publisher for Gazebo -->
  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- Differential Drive Plugin -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.288</wheel_separation> 
      <wheel_radius>0.033</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <publish_odom>true</publish_odom>
      <publish_tf>true</publish_tf>
      <publish_odom_tf>true</publish_odom_tf>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_tf>true</publish_tf>
      <publish_tf_static>true</publish_tf_static>
      <tf_frequency>30</tf_frequency>
    </plugin>
  </gazebo>

  <!-- <gazebo reference="camera_link">
    <collision>
      <origin xyz="0 0 0" rpy="1.57 0 1.57"/>
      <geometry>
        <mesh filename="package://tortoisebot_description/meshes/sensors/r200.dae"/>
      </geometry>
    </collision>

    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo> -->

</robot>