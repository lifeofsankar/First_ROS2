<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tortoisebot_description</name>
  <version>1.0.0</version>
  <description>TortoiseBot URDF Description for ROS 2 Jazzy and Gazebo Harmonic</description>
  <maintainer email="jaisankarjaikishan369@gmail.com">admin</maintainer>
  <license>Apache-2.0</license>

  <!-- Build Tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Core ROS 2 Dependencies -->
  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  
  <!-- URDF and Robot Description -->
  <depend>urdf</depend>
  <depend>xacro</depend>
  
  <!-- Robot State Publishers -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  
  <!-- Visualization -->
  <exec_depend>rviz2</exec_depend>
  
  <!-- ROS 2 Messages -->
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  
  <!-- Gazebo Harmonic Integration (CRITICAL for simulation) -->
  <depend>ros_gz_interfaces</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_image</depend>
  
  <!-- For Mapping/SLAM (Optional but highly recommended) -->
  <exec_depend>slam_toolbox</exec_depend>
  
  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>