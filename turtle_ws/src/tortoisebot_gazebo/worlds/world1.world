<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="world">

    <!-- Light and ground -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Floor friction patch (optional) -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Spawn 10 unique obstacles placed around origin.
         Types: box, cylinder, wall (thin box). -->
    <!-- 1: Box A -->
    <model name="box_A">
      <static>true</static>
      <pose>1 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
        </visual>
        <collision name="c">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 2: Box B (rotated) -->
    <model name="box_B">
      <static>true</static>
      <pose>-1 0.8 0.25 0 0 0.7854</pose>
      <link name="link">
        <visual><geometry><box><size>0.4 0.8 0.4</size></box></geometry></visual>
        <collision><geometry><box><size>0.4 0.8 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- 3: Tall Cylinder -->
    <model name="cylinder_tall">
      <static>true</static>
      <pose>0.4 -1 0.5 0 0 0</pose>
      <link name="link">
        <visual><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></visual>
        <collision><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- 4: Short Cylinder -->
    <model name="cylinder_short">
      <static>true</static>
      <pose>-0.8 -0.9 0.2 0 0 0</pose>
      <link name="link">
        <visual><geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry></visual>
        <collision><geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- 5: Wall A (long thin box) -->
    <model name="wall_A">
      <static>true</static>
      <pose>2.0 0 0.75 0 0 0</pose>
      <link name="link">
        <visual><geometry><box><size>0.1 2.0 1.5</size></box></geometry></visual>
        <collision><geometry><box><size>0.1 2.0 1.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- 6: Wall B (angled) -->
    <model name="wall_B">
      <static>true</static>
      <pose>-2.0 0 0.75 0 0 0.6</pose>
      <link name="link">
        <visual><geometry><box><size>0.1 1.8 1.5</size></box></geometry></visual>
        <collision><geometry><box><size>0.1 1.8 1.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- 7: Low Ramp-like box -->
    <model name="low_ramp">
      <static>true</static>
      <pose>0 1.6 0.15 0 0 0</pose>
      <link name="link">
        <visual><geometry><box><size>1.0 0.4 0.3</size></box></geometry></visual>
        <collision><geometry><box><size>1.0 0.4 0.3</size></box></geometry></collision>
      </link>
    </model>

    <!-- 8: Tall thin pole (very thin cylinder) -->
    <model name="pole">
      <static>true</static>
      <pose>0.8 1.2 0.75 0 0 0</pose>
      <link name="link">
        <visual><geometry><cylinder><radius>0.05</radius><length>1.5</length></cylinder></geometry></visual>
        <collision><geometry><cylinder><radius>0.05</radius><length>1.5</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- 9: Irregular box (leaning) -->
    <model name="lean_box">
      <static>true</static>
      <pose>-1.5 1.3 0.35 0 0 0.35</pose>
      <link name="link">
        <visual><geometry><box><size>0.6 0.3 0.6</size></box></geometry></visual>
        <collision><geometry><box><size>0.6 0.3 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- 10: Composite block (two boxes close) -->
    <model name="composite_block">
      <static>true</static>
      <pose>1.6 -1.2 0.35 0 0 0</pose>
      <link name="b1">
        <visual><geometry><box><size>0.4 0.4 0.4</size></box></geometry></visual>
        <collision><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
      </link>
      <link name="b2">
        <pose>0.45 0 0 0 0 0</pose>
        <visual><geometry><box><size>0.3 0.3 0.6</size></box></geometry></visual>
        <collision><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- Optional: spawn your robot from URDF via the ROS2 spawn node (see launch file) -->

  </world>
</sdf>
