<?xml version="1.0" ?>
<robot name="six-axis" xmlns:ros2_control="http://www.ros.org/wiki/ros2_control">

    <material name="gray">
        <color rgba="0.75 0.75 0.75 1.0"/>
    </material>

    <material name="silver">
        <color rgba="0.9 0.9 0.98 1.0"/>
    </material>

    <!-- Base Link -->
    <link name="base_link">
        <!-- <visual>
            <geometry>
                <box size="0.40 0.40 0.12"/>
            </geometry>
            <origin xyz="0 0 0"/>
            <material name="gray"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.40 0.40 0.12"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>

        <inertial>
            <origin xyz="0 0 0.06"/>
            <mass value="20.0"/>  
            <inertia 
                ixx="0.25" ixy="0.0" ixz="0.0"
                iyy="0.25" iyz="0.0"
                izz="0.25"/>
        </inertial> -->
    </link>

    <!-- j0 -->
    <joint name="j0" type="fixed">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="l0"/>
        <axis xyz="0.0 0.0 0.0"/>
        <limit effort="0.0" lower="0.0" upper="0.0" velocity="0.0"/>
    </joint>

    <link name="l0">
        <inertial>
            <origin xyz="0 0 0.025"/>
            <mass value="12.0"/>
            <inertia 
                ixx="0.004" ixy="0.0" ixz="0.0"
                iyy="0.004" iyz="0.0"
                izz="0.003"/>
        </inertial>

        <visual>
            <geometry>
                <cylinder length="0.05" radius="0.1"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <material name="silver"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.1"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </collision>
    </link>

    <!-- j1 -->
    <joint name="j1" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <parent link="l0"/>
        <child link="l1"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit effort="20.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0"/>
        <dynamics damping="0.2" friction="0.05"/>
    </joint>

    <link name="l1">
        <inertial>
        <origin xyz="0 0 0.1"/>
        <mass value="2.5"/>
        <inertia 
            ixx="0.010" ixy="0.0" ixz="0.0"
            iyy="0.010" iyz="0.0"
            izz="0.006"/>
        </inertial>

        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.03"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1"/>
            <material name="silver"/>
        </visual>
        <visual>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.2" radius="0.03"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1"/>
        </collision>
        <collision>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
        </collision>
    </link>

  <!-- Dummy l1 and l2 -->
  <joint name="j_dummy_1_2" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
    <parent link="l1"/>
    <child link="l2"/>
  </joint>

  <link name="l2">
    <inertial>
    <origin xyz="0.125 0 0"/>
    <mass value="3.0"/>
    <inertia 
        ixx="0.022" ixy="0.0" ixz="0.0"
        iyy="0.030" iyz="0.0"
        izz="0.015"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="0.125 0.0 0.0"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.25 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="0.125 0.0 0.0"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.25 0.0 0.0"/>
    </collision>
  </link>

  <!-- j2 -->
  <joint name="j2" type="revolute">
    <origin rpy="0.0 1.5707963267948966 0.0" xyz="0.25 0.0 0.0"/>
    <parent link="l2"/>
    <child link="l3"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-1.5707963267948966" upper="1.5707963267948966" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="l3">
    <inertial>
    <origin xyz="-0.15 0 0"/>
    <mass value="2.5"/>
    <inertia 
        ixx="0.015" ixy="0.0" ixz="0.0"
        iyy="0.020" iyz="0.0"
        izz="0.010"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.3" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="-0.15 0.0 0.0"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.3" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="-0.15 0.0 0.0"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- j3 -->
  <joint name="j3" type="revolute">
    <origin rpy="0.0 0.0 0.0" xyz="-0.30 0.0 0.0"/>
    <parent link="l3"/>
    <child link="l4"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-1.5707963267948966" upper="1.5707963267948966" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="l4">
    <inertial>
    <origin xyz="0 0 -0.12"/>
    <mass value="1.2"/>
    <inertia 
        ixx="0.004" ixy="0.0" ixz="0.0"
        iyy="0.006" iyz="0.0"
        izz="0.003"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.24" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.12"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.24" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.12"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- Dummy l4 and l5 -->
  <joint name="j_dummy" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.24"/>
    <parent link="l4"/>
    <child link="l5"/>
  </joint>

  <link name="l5">
    <inertial>
    <origin xyz="-0.16 0 0"/>
    <mass value="1.0"/>
    <inertia 
        ixx="0.003" ixy="0.0" ixz="0.0"
        iyy="0.004" iyz="0.0"
        izz="0.002"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.32" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="-0.16 0.0 0.0"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.32" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="-0.16 0.0 0.0"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- j4 -->
  <joint name="j4" type="revolute">
    <origin rpy="0.0 0.0 0.0" xyz="-0.32 0.0 0.0"/>
    <parent link="l5"/>
    <child link="l6"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-1.5707963267948966" upper="1.5707963267948966" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="l6">
    <inertial>
    <origin xyz="0 0 0.125"/>
    <mass value="0.8"/>
    <inertia 
        ixx="0.002" ixy="0.0" ixz="0.0"
        iyy="0.002" iyz="0.0"
        izz="0.0015"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.125"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.125"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- j5 -->
  <joint name="j5" type="revolute">
    <origin rpy="0.0 -1.5707963267948966 0.0" xyz="0.0 0.0 0.25"/>
    <parent link="l6"/>
    <child link="le"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="le">
    <inertial>
    <origin xyz="0 0 0.09"/>
    <mass value="0.6"/>
    <inertia 
        ixx="0.0015" ixy="0.0" ixz="0.0"
        iyy="0.0015" iyz="0.0"
        izz="0.0010"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.18" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.09"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.18" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.09"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- j6 -->
  <joint name="j6" type="revolute">
    <origin rpy="0.0 1.5707963267948966 0.0" xyz="0.0 0.0 0.18"/>
    <parent link="le"/>
    <child link="le_1"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="le_1">
    <inertial>
    <origin xyz="0 0 0.05"/>
    <mass value="0.4"/>
    <inertia 
        ixx="0.0010" ixy="0.0" ixz="0.0"
        iyy="0.0010" iyz="0.0"
        izz="0.0007"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
      <material name="gray"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

