<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

        <ros2_control name="six_axis_arm" type="system">
            <hardware>
              <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
              <!--
                  MODIFY NOTE (Gazebo Integration):
                    FROM:
                      <plugin>mock_components/GenericSystem</plugin>
                    TO:
                      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                    WHY:
                     - mock_components/GenericSystem is a FAKE hardware interface.
                     - It only works for RViz and MoveIt visualization (no physics).
                     - Gazebo requires a REAL simulation hardware interface to:
                       • expose joint state interfaces
                       • expose command interfaces
                       • connect controllers to physics
                     - gz_ros2_control/GazeboSimSystem is the official hardware plugin
                       that bridges:
                         ros2_control  ↔  Gazebo Sim (gz)
                    WITHOUT THIS CHANGE:
                     - Controllers load but cannot activate
                     - Errors like:
                       "No state interfaces found"
                       "command interface j1/position is not available"
                    WITH THIS CHANGE:
                     - Gazebo publishes joint states
                     - Controllers activate successfully
                     - Arm moves physically in Gazebo
                                                     -->
            <joint name="j1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="j2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="j3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="j4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="j5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="j6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_right_finger_joint">
              <command_interface name="effort"/>
              <state_interface name="position"/>
              <state_interface name="velocity"/>
              <state_interface name="effort"/>
            </joint>


        </ros2_control>
</robot>
