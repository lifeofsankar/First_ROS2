<?xml version="1.0" ?>
<robot
  name="six-axis"
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  xmlns:ros2_control="http://www.ros.org/wiki/ros2_control">

  <xacro:macro name="simple_transmission" params="joint">
    <transmission name="${joint}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint}">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint}_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:macro name="effort_transmission" params="joint">
  <transmission name="${joint}_effort_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${joint}">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="${joint}_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
</xacro:macro>


    <material name="gray">
        <color rgba="0.75 0.75 0.75 1.0"/>
    </material>

    <material name="silver">
        <color rgba="0.9 0.9 0.98 1.0"/>
    </material>

    <!-- Base Link -->
    <link name="base_link">
        <!-- <visual>
            <geometry>
                <box size="0.40 0.40 0.12"/>
            </geometry>
            <origin xyz="0 0 0"/>
            <material name="gray"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.40 0.40 0.12"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>

        <inertial>
            <origin xyz="0 0 0.06"/>
            <mass value="20.0"/>  
            <inertia 
                ixx="0.25" ixy="0.0" ixz="0.0"
                iyy="0.25" iyz="0.0"
                izz="0.25"/>
        </inertial> -->
    </link>

    <!-- j0 -->
    <joint name="j0" type="fixed">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="l0"/>
        <axis xyz="0.0 0.0 0.0"/>
        <limit effort="0.0" lower="0.0" upper="0.0" velocity="0.0"/>
    </joint>

    <link name="l0">
        <inertial>
            <origin xyz="0 0 0.025"/>
            <mass value="100.0"/>  
            <inertia 
                ixx="0.004" ixy="0.0" ixz="0.0"
                iyy="0.004" iyz="0.0"
                izz="0.003"/>
        </inertial>

        <visual>
            <geometry>
                <cylinder length="0.05" radius="0.1"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <material name="silver"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.1"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </collision>
    </link>

    <!-- j1 -->
    <joint name="j1" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <parent link="l0"/>
        <child link="l1"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit effort="20.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0"/>
        <dynamics damping="0.2" friction="0.05"/>
    </joint>

    <link name="l1">
        <inertial>
        <origin xyz="0 0 0.1"/>
        <mass value="3"/>
        <inertia 
            ixx="0.010" ixy="0.0" ixz="0.0"
            iyy="0.010" iyz="0.0"
            izz="0.006"/>
        </inertial>

        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.03"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1"/>
            <material name="silver"/>
        </visual>
        <visual>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.2" radius="0.03"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1"/>
        </collision>
        <collision>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
        </collision>
    </link>

  <!-- Dummy l1 and l2 -->
  <joint name="j_dummy_1_2" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
    <parent link="l1"/>
    <child link="l2"/>
  </joint>

  <link name="l2">
    <inertial>
    <origin xyz="0.125 0 0"/>
    <mass value="2.5"/>
    <inertia 
        ixx="0.022" ixy="0.0" ixz="0.0"
        iyy="0.030" iyz="0.0"
        izz="0.015"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="0.125 0.0 0.0"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.25 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="0.125 0.0 0.0"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.25 0.0 0.0"/>
    </collision>
  </link>

  <!-- j2 -->
  <joint name="j2" type="revolute">
    <origin rpy="0.0 1.5707963267948966 0.0" xyz="0.25 0.0 0.0"/>
    <parent link="l2"/>
    <child link="l3"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="30.0" lower="-1.5707963267948966" upper="1.5707963267948966" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.08"/>

  </joint>

  <link name="l3">
    <inertial>
    <origin xyz="-0.15 0 0"/>
    <mass value="2.2"/>
    <inertia 
        ixx="0.015" ixy="0.0" ixz="0.0"
        iyy="0.020" iyz="0.0"
        izz="0.010"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.3" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="-0.15 0.0 0.0"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.3" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="-0.15 0.0 0.0"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- j3 -->
  <joint name="j3" type="revolute">
    <origin rpy="0.0 0.0 0.0" xyz="-0.30 0.0 0.0"/>
    <parent link="l3"/>
    <child link="l4"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-1.5707963267948966" upper="1.5707963267948966" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="l4">
    <inertial>
    <origin xyz="0 0 -0.12"/>
    <mass value="1.2"/>
    <inertia 
        ixx="0.004" ixy="0.0" ixz="0.0"
        iyy="0.006" iyz="0.0"
        izz="0.003"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.24" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.12"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.24" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.12"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- Dummy l4 and l5 -->
  <joint name="j_dummy" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.24"/>
    <parent link="l4"/>
    <child link="l5"/>
  </joint>

  <link name="l5">
    <inertial>
    <origin xyz="-0.16 0 0"/>
    <mass value="1.0"/>
    <inertia 
        ixx="0.003" ixy="0.0" ixz="0.0"
        iyy="0.004" iyz="0.0"
        izz="0.002"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.32" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="-0.16 0.0 0.0"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.32" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 1.5707963267948966 0.0" xyz="-0.16 0.0 0.0"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- j4 -->
  <joint name="j4" type="revolute">
    <origin rpy="0.0 0.0 0.0" xyz="-0.32 0.0 0.0"/>
    <parent link="l5"/>
    <child link="l6"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-1.5707963267948966" upper="1.5707963267948966" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="l6">
    <inertial>
    <origin xyz="0 0 0.125"/>
    <mass value="0.8"/>
    <inertia 
        ixx="0.002" ixy="0.0" ixz="0.0"
        iyy="0.002" iyz="0.0"
        izz="0.0015"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.125"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.125"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- j5 -->
  <joint name="j5" type="revolute">
    <origin rpy="0.0 -1.5707963267948966 0.0" xyz="0.0 0.0 0.25"/>
    <parent link="l6"/>
    <child link="le"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="le">
    <inertial>
    <origin xyz="0 0 0.09"/>
    <mass value="0.6"/>
    <inertia 
        ixx="0.0015" ixy="0.0" ixz="0.0"
        iyy="0.0015" iyz="0.0"
        izz="0.0010"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.18" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.09"/>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.18" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.09"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- j6 -->
  <joint name="j6" type="revolute">
    <origin rpy="0.0 1.5707963267948966 0.0" xyz="0.0 0.0 0.18"/>
    <parent link="le"/>
    <child link="le_1"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="20.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>

  </joint>

  <link name="le_1">
    <inertial>
    <origin xyz="0 0 0.05"/>
    <mass value="0.4"/>
    <inertia 
        ixx="0.0010" ixy="0.0" ixz="0.0"
        iyy="0.0010" iyz="0.0"
        izz="0.0007"/>
    </inertial>

    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
      <material name="gray"/>
    </visual>
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.03"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
    </collision>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </collision>
  </link>

  <!-- Connect wrist to gripper base -->
  <joint name="le_1_to_g_base" type="fixed">
    <origin xyz="0 0 0.10"/>
    <parent link="le_1"/>
    <child link="g_base"/>
  </joint>

  <!-- Gripper base -->
  <link name="g_base">
    <visual>
      <geometry>
        <box size="0.05 0.15 0.03"/>
      </geometry>
      <origin xyz="0 0 0.015"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.15 0.03"/>
      </geometry>
      <origin xyz="0 0 0.015"/>
    </collision>
    <inertial>
    <origin xyz="0 0 0.015"/>
    <mass value="0.5"/>
    <inertia 
        ixx="0.0025" ixy="0.0" ixz="0.0"
        iyy="0.0015" iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>

  <!-- Gripper Right Finger -->
  <link name="gripper_right_finger">
    <visual>
      <geometry>
        <box size="0.05 0.015 0.12"/>
      </geometry>
      <origin xyz="0 0.0075 0.06"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.015 0.12"/>
      </geometry>
      <origin xyz="0 0.0075 0.06"/>
    </collision>
    <inertial>
    <origin xyz="0 0.0075 0.06"/>
    <mass value="0.1"/>
    <inertia 
        ixx="0.00010" ixy="0.0" ixz="0.0"
        iyy="0.00012" iyz="0.0"
        izz="0.00002"/>
    </inertial>

  </link>

  <joint name="gripper_right_finger_joint" type="prismatic">
    <axis xyz="0 1 0"/>
    <origin xyz="0.0 -0.07 0.03" rpy="0.0 0.0 0.0"/>
    <parent link="g_base"/>
    <child link="gripper_right_finger"/>
    <limit effort="100.0" lower="0.0" upper="0.05" velocity="1.0"/>
    <dynamics damping="2.0" friction="1.0"/>

  </joint>

  <!-- Gripper Left Finger -->
  <link name="gripper_left_finger">
    <visual>
      <geometry>
        <box size="0.05 0.015 0.12"/>
      </geometry>
      <origin xyz="0 -0.0075 0.06"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.015 0.12"/>
      </geometry>
      <origin xyz="0 -0.0075 0.06"/>
    </collision>
    <inertial>
    <origin xyz="0 -0.0075 0.06"/>
    <mass value="0.1"/>
    <inertia 
        ixx="0.00010" ixy="0.0" ixz="0.0"
        iyy="0.00012" iyz="0.0"
        izz="0.00002"/>
    </inertial>

  </link>

  <joint name="gripper_left_finger_joint" type="prismatic">
    <axis xyz="0 1 0"/>
    <origin xyz="0.0 0.07 0.03" rpy="0.0 0.0 0.0"/>
    <parent link="g_base"/>
    <child link="gripper_left_finger"/>
    <limit effort="100.0" lower="-0.05" upper="0.0" velocity="1.0"/>
    <dynamics damping="2.0" friction="1.0"/>

    <mimic joint="gripper_right_finger_joint" multiplier="-1.0" offset="0"/>
  </joint>

  <!-- Tool Center Point (TCP) / End Effector Frame -->
  <link name="tool0"/>
  
  <joint name="g_base_to_tool0" type="fixed">
    <origin xyz="0 0 0.03" rpy="3.14159 0 0"/>
    <parent link="g_base"/>
    <child link="tool0"/>
  </joint>

  <xacro:include filename="six-axis.ros2_control.xacro" />

  <xacro:include filename="$(find arm_gazebo)/urdf/gazebo_plugins.xacro"/>
  <xacro:add_gazebo_plugins/>


  <xacro:simple_transmission joint="j1"/>
  <xacro:simple_transmission joint="j2"/>
  <xacro:simple_transmission joint="j3"/>
  <xacro:simple_transmission joint="j4"/>
  <xacro:simple_transmission joint="j5"/>
  <xacro:simple_transmission joint="j6"/>
  <!-- <xacro:simple_transmission joint="gripper_right_finger_joint"/> -->
  <xacro:effort_transmission joint="gripper_right_finger_joint"/>


  <gazebo reference="gripper_left_finger">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>100000</kp>
    <kd>10</kd>
  </gazebo>

  <gazebo reference="gripper_right_finger">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>100000</kp>
    <kd>10</kd>
  </gazebo>



</robot>