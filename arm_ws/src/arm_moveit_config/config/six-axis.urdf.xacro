<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six-axis">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import six-axis urdf file -->
    <xacro:include filename="$(find arm_description)/urdf/arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="six-axis.ros2_control.xacro" />


    <xacro:six-axis_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
